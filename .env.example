# Server
PORT=18080
NODE_ENV=development

# Database
# Default: sqlite. This makes the service independent from n8n/Postgres.
# Other supported future modes: direct_postgres, n8n_gateway.
DB_ACCESS_MODE=sqlite

# SQLite mode. In Docker, mount ./data or /app/data as a persistent volume.
SQLITE_DB_PATH=./data/bitrix-tg.sqlite

# Direct DB mode example: postgresql://postgres:postgres@localhost:5432/bitrix_tg
DATABASE_URL=

# n8n DB gateway mode. Keep empty unless using n8n as a temporary bridge.
N8N_DB_GATEWAY_URL=https://n8n.svarnoy.org/webhook/8fae2cce-562b-47b4-95db-cc240df910bd
N8N_DB_GATEWAY_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional private/admin destination for failed scheduled publication alerts.
TELEGRAM_ADMIN_CHAT_ID=609150103
# Optional, only for Telegram forum topics:
TELEGRAM_MESSAGE_THREAD_ID=

# Retry transient Telegram network/API errors. Permanent 4xx errors are not retried.
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_DELAY_MS=500

# Photo delivery:
# upload = service downloads Bitrix photos and uploads files to Telegram (most robust)
# auto = try URL first, then upload on Telegram URL-fetch errors
# url = only pass encoded URLs to Telegram
TELEGRAM_PHOTO_DELIVERY_MODE=upload
TELEGRAM_PHOTO_DOWNLOAD_TIMEOUT_MS=15000

# MAX
# MAX_CHAT_ID is the chat/channel id returned by MAX links/API, not the public URL.
MAX_TOKEN=
MAX_CHAT_ID=
MAX_API_BASE_URL=https://platform-api2.max.ru
# For local Windows runs against MAX, point Node to the Russian trusted CA bundle if needed:
# NODE_EXTRA_CA_CERTS=./data/certs/russian_trusted_ca_bundle.pem

# VK
# VK_TOKEN is the community token used for wall.post/wall.delete.
# VK_ACCESS_TOKEN is the user access token used for photos.getWallUploadServer/photos.saveWallPhoto.
VK_TOKEN=
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_POST_AS_GROUP=true

# AI text preparation/fitting through OpenRouter.
# event/promo/company_news posts are prepared with an SMM prompt up to ~1000 chars.
# entertainment/unknown posts are formatted deterministically without AI.
# Platform limits are still enforced after preparation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://svarnoy-market.ru
OPENROUTER_APP_TITLE=bitrix-tg
OPENROUTER_TIMEOUT_MS=20000
# Backward-compatible aliases. If OPENROUTER_API_KEY is empty, OPENAI_API_KEY is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Webhook security
# Optional shared secret. If set, Bitrix/n8n must send the same value
# in the x-webhook-secret header.
WEBHOOK_SECRET=

# Bitrix / content mapping
# Optional exact JSON field path for activity start, e.g. DATE_ACTIVE_FROM
# or all_properties.CUSTOM_ACTIVE_FROM. Defaults also try ACTIVE_FROM/DATE_ACTIVE_FROM.
BITRIX_ACTIVE_FROM_FIELD=
BITRIX_REQUIRE_EXACT_ACTIVE_FROM=true
# Bitrix sends date strings without timezone. Production site time is Moscow by default.
BITRIX_LOCAL_UTC_OFFSET_MINUTES=180

# Optional fallback when Bitrix sends all_properties.PHOTOS as file ids such as
# "253902" instead of URL objects. Leave empty if Bitrix always sends {id,url,path}.
BITRIX_FILE_RESOLVER_URL=

# Publishing behavior
# plain, html, or markdownv2. Start with plain for fewer Telegram parse errors.
TELEGRAM_PARSE_MODE=plain

# Media sync policy for edited albums:
# rebuild = delete old media messages and resend; soft = edit/diff where possible.
TELEGRAM_MEDIA_SYNC_POLICY=rebuild
